# ============================================================
# .gitignore — Archivos a NO subir al repositorio
# ============================================================

# Dependencias
node_modules/

# Build de producción
dist/

# Configuración con credenciales
config.php
.env
.env.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Backups de base de datos
*.sql.bak
*.sqlite
*.sqlite3

# Datos SQLite en ejecución: deben persistir en el volumen, no en Git
data/
*.db
*.db-shm
*.db-wal

# Archivos temporales
*.tmp
*.bak
