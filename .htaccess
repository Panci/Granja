# ============================================================
# .htaccess para ERP Animal en Hostinger (Apache)
# ============================================================
# Coloca este archivo en la raíz de public_html/
# ============================================================

# Activar motor de reescritura
RewriteEngine On

# Forzar HTTPS (opcional, recomendado en producción)
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Bloquear acceso directo a archivos de configuración y node_modules
<FilesMatch "\.(env|sqlite|md)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(config\.php|config\.example\.php|package\.json|package-lock\.json|schema\.sql)$">
  Require all denied
</FilesMatch>

# Headers de seguridad
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # CSP para Hostinger (ajusta según tus necesidades)
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
</IfModule>

# Compresión GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache de archivos estáticos (1 año)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# Servir index.html como página principal
DirectoryIndex index.html

# Configuración para SPA: redirigir todas las rutas no-archivo a index.html
# (La app no tiene rutas, pero por si acaso)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api\.php
RewriteRule ^(.*)$ /index.html [L]

# Configuración PHP
<IfModule mod_php.c>
  php_value upload_max_filesize 10M
  php_value post_max_size 10M
  php_value max_execution_time 60
  php_flag display_errors off
</IfModule>
